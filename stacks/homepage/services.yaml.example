- Infrastructure:
    - Homepage:
        icon: mdi-view-dashboard-#38bdf8
        href: http://dashboard.local/
        description: Dashboard
    - Portainer:
        icon: portainer.svg
        href: http://portainer.local/
        description: Docker Management
    - Nginx Proxy Manager:
        icon: nginx-proxy-manager.svg
        href: http://npm.local/
        description: Domains & Proxy Management
    - AdGuard Home:
        icon: adguard-home.svg
        href: http://adguard.local/
        description: Network Ad-Blocker
        widget:
          type: adguard
          url: http://192.168.0.45:8080
          username: george
          password: YOUR_ADGUARD_PASSWORD
    - File Browser:
        icon: filebrowser-quantum.png
        href: http://192.168.0.45:8082/
        description: File Manager

- Downloads:
    - Deluge:
        icon: deluge.svg
        href: http://deluge.local/
        description: Torrent Client (VPN)
        widget:
          type: deluge
          url: http://192.168.0.45:8112
          password: YOUR_DELUGE_PASSWORD
    - Prowlarr:
        icon: prowlarr.svg
        href: http://192.168.0.45:9696
        description: Indexer Manager
        widget:
          type: prowlarr
          url: http://192.168.0.45:9696
          key: YOUR_PROWLARR_API_KEY
    - Sonarr:
        icon: sonarr.svg
        href: http://192.168.0.45:8989
        description: TV Series
        widget:
          type: sonarr
          url: http://192.168.0.45:8989
          key: YOUR_SONARR_API_KEY
    - Radarr:
        icon: radarr.svg
        href: http://192.168.0.45:7878
        description: Movies
        widget:
          type: radarr
          url: http://192.168.0.45:7878
          key: YOUR_RADARR_API_KEY
    - Gluetun:
        icon: gluetun.svg
        href: http://192.168.0.45:8001
        description: VPN Gateway
        widget:
          type: gluetun
          url: http://192.168.0.45:8001

- Media:
